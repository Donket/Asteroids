tracks/1/type = "value"
tracks/1/imported = false
tracks/1/enabled = true
tracks/1/path = NodePath("TextLabel:text")
tracks/1/interp = 1
tracks/1/loop_wrap = true
tracks/1/keys = {
"times": PackedFloat32Array(0),
"transitions": PackedFloat32Array(1),
"update": 1,
"values": ["Use [E] to open and close your inventory. In your inventory you will find six asteroid slots. You can click and drag to rearrange these. 

When you drag two asteroids of the same type onto each other, they combine to gain experience, and when they hit three experience their abilities level up and their experience resets.

When you have your inventory open, you can sell your existing asteroids AND stars for half of their value by dragging them over the sell box and releasing them.

Remember, you can have only have six asteroids and six stars at a time! Choose wisely which stars and asteroids you buy."]
}

