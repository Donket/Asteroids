}
tracks/1/type = "value"
tracks/1/imported = false
tracks/1/enabled = true
tracks/1/path = NodePath("TextLabel:text")
tracks/1/interp = 1
tracks/1/loop_wrap = true
tracks/1/keys = {
"times": PackedFloat32Array(0),
"transitions": PackedFloat32Array(1),
"update": 1,
"values": ["Certain abilities apply status effects to the ship. These are:

[img]res://ART/icons/breachIcon.png[/img] Breach: Every second, lose 2% of current health, times the amount of breach

[img]res://ART/icons/burnoutIcon.png[/img]Burnout: Every 5 seconds take 3 damage times the amount of burnout, and become slowed and unable to shoot briefly (this disable stacks to a max of 3 seconds).

[img]res://ART/icons/parasiteIcon.png[/img] Parasite: Every 0.2 seconds, there is a chance to spawn the asteroid in your first launcher slot behind the ship. This chance increases with amount of parasite.

[img]res://ART/icons/blockIcon.png[/img] Block: When an asteroid is shot, if you have any block a charge is used and the asteroid is not destroyed as normal."]
}

