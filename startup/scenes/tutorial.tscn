}
tracks/1/type = "value"
tracks/1/imported = false
tracks/1/enabled = true
tracks/1/path = NodePath("TextLabel:text")
tracks/1/interp = 1
tracks/1/loop_wrap = true
tracks/1/keys = {
"times": PackedFloat32Array(0),
"transitions": PackedFloat32Array(1),
"update": 1,
"values": ["\"On Crash:\" Triggers whenever an asteroid dies by hitting a wall or hitting the ship.

\"On Hit:\" Triggers whenever an asteroid dies by hitting the ship.

\"On Shot:\" Triggers whenever an asteroid dies by by a bullet shot by the ship.

\"On Spawn\": Triggers whenever an asteroid is spawned by a launcher or by an ability.

\"On Bounce:\" Triggers whenever an asteroid bounces off a wall."]
}

